# Copy to .env. Real environment variables win. Never commit .env.

# Discord: https://discord.com/developers/applications -> your app
DISCORD_TOKEN=
DISCORD_APP_ID=
# Optional: register the commands in one server only (instant). Empty = global.
DISCORD_GUILD_ID=

# send21: scoped API key from https://send21.io/api-keys (drafts:write + drafts:read).
# Leave empty to run in mock mode: no calls to send21, a local mock pay page.
SEND21_API_KEY=
# Signing secret, shown once when you create the webhook (npm run webhook:register).
SEND21_WEBHOOK_SECRET=
# Optional, defaults to https://send21.io
# SEND21_API_BASE=https://send21.io

# Webhook server
PORT=3000
# Public HTTPS address of this server (send21 refuses private addresses).
PUBLIC_URL=https://tips.example.com

# Tips
TIP_MAX_AMOUNT=500
TIP_EXPIRY_HOURS=24
# Accept payments up to this many percent short automatically (0-10, exchange fees).
TIP_SHORTFALL_PERCENT=2
# Where tips, users and delivery ids are kept
DATA_FILE=./data/tipbot.json
